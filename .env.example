# Amap Weather Query System Configuration
# Copy this file to .env and fill in your actual API key

# Amap Open Platform API Key
# Get your key from: https://console.amap.com/dev/key/app
AMAP_API_KEY=your_amap_api_key_here

# Amap API Endpoints (usually don't need to change)
AMAP_WEATHER_URL=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
